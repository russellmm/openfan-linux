<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OpenFan.Linux.App.GraphEditorWindow"
        Title="Edit graph"
        Width="920" Height="660"
        Background="#171B1F"
        WindowStartupLocation="CenterOwner">

  <Grid RowDefinitions="Auto,*,Auto" Margin="22,16,22,16">

    <!-- Header: name + live temp left, hysteresis right (reference: OpenFan-graph.jpg) -->
    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
      <StackPanel Grid.Column="0">
        <TextBlock x:Name="TitleText" FontSize="21" FontWeight="Bold" Foreground="#F2F2F2" />
        <TextBlock x:Name="TempReadout" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,2,0,0" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <TextBlock Text="Hysteresis" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" />
        <NumericUpDown x:Name="HystCBox" Width="84" Minimum="0" Maximum="10" Increment="0.5" FormatString="0.#" />
        <TextBlock Text="°C ·" VerticalAlignment="Center" />
        <NumericUpDown x:Name="HystSBox" Width="84" Minimum="0" Maximum="30" Increment="0.5" FormatString="0.#" />
        <TextBlock Text="sec" VerticalAlignment="Center" />
      </StackPanel>
    </Grid>

    <!-- Plot -->
    <Border Grid.Row="1" Background="#14181B" BorderBrush="#2C363D" BorderThickness="1" CornerRadius="10">
      <Canvas x:Name="Plot" ClipToBounds="True" />
    </Border>

    <!-- Bottom controls + commit buttons -->
    <StackPanel Grid.Row="2" Spacing="12" Margin="0,14,0,0">
      <WrapPanel Orientation="Horizontal">

        <TextBlock Text="Name" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="0,0,8,0" />
        <TextBox x:Name="NameBox" Width="190" Margin="0,0,24,0" Watermark="curve name" />

        <TextBlock Text="Sensor" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="0,0,8,0" />
        <ComboBox x:Name="SensorBox" Width="250" Margin="0,0,24,0" />

        <TextBlock Text="Selected:" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="0,0,8,0" />
        <NumericUpDown x:Name="SelTempBox" Width="96" Minimum="0" Maximum="150" Increment="0.5" FormatString="0.#" Margin="0,0,4,0" />
        <TextBlock Text="°C  %" VerticalAlignment="Center" Margin="0,0,4,0" />
        <NumericUpDown x:Name="SelPctBox" Width="86" Minimum="0" Maximum="100" Increment="1" FormatString="0" Margin="0,0,24,0" />

        <TextBlock Text="Max.speed" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="0,0,8,0" />
        <NumericUpDown x:Name="MaxSpeedBox" Width="86" Minimum="10" Maximum="100" Increment="5" FormatString="0" Margin="0,0,20,0" />

        <TextBlock Text="Min.temp" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="0,0,8,0" />
        <NumericUpDown x:Name="MinTempBox" Width="86" Minimum="0" Maximum="140" Increment="5" FormatString="0" Margin="0,0,20,0" />

        <TextBlock Text="Max.temp" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="0,0,8,0" />
        <NumericUpDown x:Name="MaxTempBox" Width="86" Minimum="10" Maximum="150" Increment="5" FormatString="0" Margin="0,0,20,0" />

        <Button x:Name="AddPointBtn" Content="+ Point" Margin="0,0,8,0" />
        <Button x:Name="RemovePointBtn" Content="− Point" />
      </WrapPanel>

      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="12">
        <Button x:Name="CancelBtn" Content="Cancel" MinWidth="120" Height="36" />
        <Button x:Name="OkBtn" Classes="accent" Content="Ok" MinWidth="120" Height="36" />
      </StackPanel>
    </StackPanel>
  </Grid>
</Window>
