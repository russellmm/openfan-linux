<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OpenFan.Linux.App.App"
             RequestedThemeVariant="Dark">

  <!-- Windows OpenFan design language (screenshots/): bluish dark slate + orange accent. -->
  <Application.Resources>
    <Color x:Key="SystemAccentColor">#F0A03C</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#F0A03C" />
    <SolidColorBrush x:Key="CardBrush" Color="#1E2429" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#2C363D" />
    <SolidColorBrush x:Key="TextSecondary" Color="#8FA0AA" />
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />

    <!-- Left nav rail item: orange bar + white text when active (reference: GPU screen). -->
    <Style Selector="RadioButton.nav">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" Padding="0,11">
            <Grid ColumnDefinitions="4,*">
              <Rectangle x:Name="bar" Fill="#F0A03C" IsHitTestVisible="False" />
              <ContentPresenter Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <Style Selector="RadioButton.nav:not(:checked) /template/ Rectangle#bar">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="RadioButton.nav /template/ ContentPresenter">
      <Setter Property="TextBlock.Foreground" Value="#8FA0AA" />
    </Style>
    <Style Selector="RadioButton.nav:pointerover /template/ ContentPresenter">
      <Setter Property="TextBlock.Foreground" Value="#D6DEE3" />
    </Style>
    <Style Selector="RadioButton.nav:checked /template/ ContentPresenter">
      <Setter Property="TextBlock.Foreground" Value="#FFFFFF" />
    </Style>

    <!-- Ok-style solid accent button (reference: graph/calibration dialogs). -->
    <Style Selector="Button.accent">
      <Setter Property="Background" Value="#F0A03C" />
      <Setter Property="Foreground" Value="#14181B" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
  </Application.Styles>
</Application>
