<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="OpenFan.Linux.App.App"
             RequestedThemeVariant="Dark">

  <!-- Dark card language + OpenFan accent #E24B4B (spec §6). -->
  <Application.Resources>
    <Color x:Key="SystemAccentColor">#E24B4B</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="#E24B4B" />
    <SolidColorBrush x:Key="CardBrush" Color="#1E1E1E" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#2E2E2E" />
    <SolidColorBrush x:Key="TextSecondary" Color="#9A9A9A" />
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
  </Application.Styles>
</Application>
