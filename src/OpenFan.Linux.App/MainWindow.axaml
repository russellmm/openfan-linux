<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OpenFan.Linux.App.MainWindow"
        Title="OpenFan"
        Width="1240" Height="800"
        Background="#171B1F"
        WindowStartupLocation="CenterScreen">

  <Grid ColumnDefinitions="152,*">

    <!-- Nav rail (reference: OpenFan-GPU-Screen.jpg) -->
    <Border Grid.Column="0" Background="#101416">
      <StackPanel Margin="0,20,0,0" Spacing="2">
        <TextBlock Text="OpenFan" FontWeight="Bold" FontSize="17" Foreground="#F2F2F2"
                   Margin="22,0,0,18" />
        <RadioButton x:Name="NavHome"  Classes="nav" Content="Home"     GroupName="page" IsChecked="True" />
        <RadioButton x:Name="NavGpus"  Classes="nav" Content="GPUs"     GroupName="page" />
        <RadioButton x:Name="NavSensors" Classes="nav" Content="Sensors" GroupName="page" />
        <RadioButton x:Name="NavTheme" Classes="nav" Content="Theme"    GroupName="page" />
        <RadioButton x:Name="NavTray"  Classes="nav" Content="Tray"     GroupName="page" />
        <RadioButton x:Name="NavSettings" Classes="nav" Content="Settings" GroupName="page" />
        <RadioButton x:Name="NavAbout" Classes="nav" Content="About"    GroupName="page" />
      </StackPanel>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" Margin="26,18,26,16">

      <!-- Page header: title + subtitle left; actions + clock right (reference: OpenFan top bar) -->
      <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,6">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="14" VerticalAlignment="Bottom">
          <TextBlock x:Name="PageTitle" Text="Home" FontSize="24" FontWeight="Bold" Foreground="#F2F2F2" />
          <TextBlock x:Name="PageSubtitle" VerticalAlignment="Bottom" Margin="0,0,0,5"
                     Foreground="{StaticResource TextSecondary}" FontSize="13" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Bottom">
          <CheckBox x:Name="ApplyCurvesBox" Content="Apply curves" VerticalAlignment="Center" FontSize="14" />
          <Button x:Name="RefreshBtn" Content="Refresh" Height="32" />
          <Button x:Name="MenuBtn" Content="⋮" Width="38" Height="32">
            <Button.Flyout>
              <MenuFlyout Placement="BottomEdgeAlignedRight">
                <MenuItem Header="Save setup as…" Click="OnSaveSetupAs" />
                <MenuItem Header="Load setup…" Click="OnLoadSetup" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button x:Name="ExitBtn" Content="Exit" Height="32" />
          <TextBlock x:Name="ClockText" VerticalAlignment="Center" Margin="6,0,0,0"
                     Foreground="{StaticResource TextSecondary}" FontSize="13" />
        </StackPanel>
      </Grid>

      <!-- Home: apply bar + Controls + Curves sections (reference: OpenFan-mainpage.jpg) -->
      <DockPanel x:Name="HomePanel" Grid.Row="1" Grid.RowSpan="2">
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*" Margin="0,4,0,12">
          <TextBlock x:Name="StatusNote" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" />
        </Grid>

        <Grid>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled">
            <StackPanel>
              <TextBlock Text="Controls" FontSize="16" FontWeight="SemiBold" Foreground="#E8EDF0" Margin="6,0,0,2" />
              <ItemsControl x:Name="Cards">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>

              <TextBlock x:Name="CurvesHeader" Text="Curves" FontSize="16" FontWeight="SemiBold"
                         Foreground="#E8EDF0" Margin="6,20,0,2" IsVisible="False" />
              <ItemsControl x:Name="CurveCards" Margin="0,0,0,100">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel Orientation="Horizontal" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>

          <!-- Create-curve FABs (reference: bottom-right of Home) -->
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                      Spacing="12" Margin="0,0,18,18">
            <Button x:Name="NewFlatFab" Classes="fab">
              <TextBlock TextAlignment="Center"><Run FontSize="15" Text="—"/><LineBreak/><Run FontSize="11" Text="Flat"/></TextBlock>
            </Button>
            <Button x:Name="NewGraphFab" Classes="fab">
              <TextBlock TextAlignment="Center"><Run FontSize="15" Text="∿"/><LineBreak/><Run FontSize="11" Text="Graph"/></TextBlock>
            </Button>
            <Button x:Name="NewMixFab" Classes="fab">
              <TextBlock TextAlignment="Center"><Run FontSize="15" Text="×+"/><LineBreak/><Run FontSize="11" Text="Mix"/></TextBlock>
            </Button>
          </StackPanel>
        </Grid>
      </DockPanel>

      <!-- GPUs: per-card detail panels (populated in code) -->
      <ScrollViewer x:Name="GpusPanel" Grid.Row="1" Grid.RowSpan="2" IsVisible="False"
                    HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="GpusContent" Spacing="14" />
      </ScrollViewer>

      <!-- Sensors: full inventory with friendly renaming (populated in code) -->
      <ScrollViewer x:Name="SensorsPanel" Grid.Row="1" Grid.RowSpan="2" IsVisible="False"
                    HorizontalScrollBarVisibility="Disabled">
        <StackPanel x:Name="SensorsContent" Spacing="14" Margin="0,0,80,0" />
      </ScrollViewer>

      <!-- Theme / Tray / Settings / About placeholders -->
      <TextBlock x:Name="StubPage" Grid.Row="1" Grid.RowSpan="2" IsVisible="False"
                 Foreground="{StaticResource TextSecondary}" FontSize="14"
                 VerticalAlignment="Center" HorizontalAlignment="Center" TextWrapping="Wrap"
                 MaxWidth="560" TextAlignment="Center" />
    </Grid>
  </Grid>
</Window>
