<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OpenFan.Linux.App.CalibrationWindow"
        Title="Manual Fan Calibration"
        Width="1180" Height="740"
        Background="#171B1F"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/OpenFan.ico">

  <Grid RowDefinitions="Auto,*,Auto" Margin="26,18,26,16">

    <StackPanel Grid.Row="0" Margin="0,0,0,14">
      <TextBlock Text="Manual Fan Calibration" FontSize="22" FontWeight="Bold" Foreground="#F2F2F2" />
      <TextBlock x:Name="SubtitleText" Foreground="{StaticResource TextSecondary}" FontSize="13" Margin="0,3,0,0" />
    </StackPanel>

    <Grid Grid.Row="1" ColumnDefinitions="460,*">

      <!-- Live drive card (reference: teal slider card) -->
      <StackPanel Grid.Column="0" Spacing="14" Margin="0,0,26,0">
        <Border Background="#2C444C" CornerRadius="12" Padding="18">
          <StackPanel Spacing="8">
            <TextBlock x:Name="FanNameText" FontWeight="SemiBold" FontSize="15" Foreground="#F2F2F2" />
            <Slider x:Name="DutySlider" Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" />
            <Grid ColumnDefinitions="Auto,*">
              <Border BorderBrush="#F0A03C" BorderThickness="2" CornerRadius="6" Padding="14,6">
                <TextBlock x:Name="PctText" Text="0 %" FontSize="24" FontWeight="Bold" Foreground="#F2F2F2" />
              </Border>
              <TextBlock x:Name="LiveRpmText" Grid.Column="1" VerticalAlignment="Center" Margin="18,0,0,0"
                         FontSize="17" Foreground="#E8EDF0" HorizontalAlignment="Right" />
            </Grid>
          </StackPanel>
        </Border>

        <Button x:Name="AddCurrentBtn" Content="Add (0%, 0 RPM)" HorizontalAlignment="Stretch" Height="40" />

        <Grid ColumnDefinitions="Auto,Auto,*,Auto">
          <TextBlock Text="Point %" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="0,0,10,0" />
          <NumericUpDown x:Name="PointPctBox" Grid.Column="1" Width="110" Minimum="0" Maximum="100" Increment="5" FormatString="0" />
          <Button x:Name="AddPointBtn" Grid.Column="3" Content="Add" MinWidth="120" Height="36" />
        </Grid>

        <Button x:Name="AutoStepBtn" Content="Auto step 20–100%" HorizontalAlignment="Stretch" Height="40" />
      </StackPanel>

      <!-- Sample table -->
      <StackPanel Grid.Column="1">
        <Grid ColumnDefinitions="150,210,90,60" Margin="0,0,0,8">
          <TextBlock Text="Command (%)" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold" />
          <TextBlock Grid.Column="1" Text="Speed (RPM)" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold" />
          <TextBlock Grid.Column="2" Text="Avoid" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold" />
          <TextBlock Grid.Column="3" Text="Del" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold" />
        </Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="Rows" Spacing="6" />
        </ScrollViewer>
      </StackPanel>
    </Grid>

    <!-- Validation + commit -->
    <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,14,0,0">
      <StackPanel x:Name="Checks" Spacing="3">
        <TextBlock x:Name="CheckTwoPoints" FontSize="13" />
        <TextBlock x:Name="CheckAscending" FontSize="13" />
        <TextBlock x:Name="CheckAvoidContiguous" FontSize="13" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12">
        <Button x:Name="CancelBtn" Content="Cancel" MinWidth="120" Height="36" />
        <Button x:Name="OkBtn" Classes="accent" Content="Ok" MinWidth="120" Height="36" IsEnabled="False" />
      </StackPanel>
    </Grid>
  </Grid>
</Window>
