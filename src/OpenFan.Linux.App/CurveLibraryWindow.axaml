<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="OpenFan.Linux.App.CurveLibraryWindow"
        Title="Curves"
        Width="680" Height="540"
        Background="#171B1F"
        WindowStartupLocation="CenterOwner">

  <Grid RowDefinitions="Auto,*,Auto,Auto" Margin="20,16,20,16">

    <StackPanel Grid.Row="0" Margin="0,0,0,12">
      <TextBlock Text="Curve library" FontSize="20" FontWeight="Bold" Foreground="#F2F2F2" />
      <TextBlock Text="Curves are independent — a graph binds its own sensor; assign curves to fans on the Home page."
                 Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,2,0,0" />
    </StackPanel>

    <Border Grid.Row="1" Background="#1E2429" BorderBrush="#2C363D" BorderThickness="1" CornerRadius="10">
      <ListBox x:Name="CurveList" Background="Transparent" BorderThickness="0" Margin="4" />
    </Border>

    <Grid Grid.Row="2" ColumnDefinitions="Auto,*,Auto" Margin="0,12,0,0">
      <TextBlock Text="Name" VerticalAlignment="Center" Foreground="{StaticResource TextSecondary}" Margin="0,0,10,0" />
      <TextBox x:Name="NameBox" Grid.Column="1" IsEnabled="False" Watermark="select a curve…" />
    </Grid>

    <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" Margin="0,14,0,0">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="NewGraphBtn" Content="New graph" />
        <Button x:Name="NewFlatBtn" Content="New flat" />
        <Button x:Name="EditBtn" Content="Edit…" IsEnabled="False" />
        <Button x:Name="DeleteBtn" Content="Delete" IsEnabled="False" />
      </StackPanel>
      <TextBlock x:Name="NoteText" Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0"
                 Foreground="#EF6B6B" FontSize="12" TextWrapping="Wrap" />
      <Button x:Name="CloseBtn" Grid.Column="2" Content="Close" MinWidth="100" />
    </Grid>
  </Grid>
</Window>
